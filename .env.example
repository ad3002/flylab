# FlyLab Configuration Environment Variables
# Domain: flylab.aglabx.com

# Server network settings
HOST=127.0.0.1
PORT=8080
DOMAIN=flylab.aglabx.com

# Database and paths
DB_PATH=flylab.db
DATA_DIR=data
ARTIFACTS_DIR=artifacts
REGISTRY_DIR=registry
CONTRACTS_DIR=contracts
WEB_DIR=web

# Simulation binary
FLYSIM_BIN=bin/flysim

# Natural-language planner: Claude Code CLI in print mode (`claude -p`).
# If CLAUDE_BIN is not found, /plans/parse falls back to a keyword parser and reports llm_error.
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=90
# Global number of concurrent claude processes; requests wait up to 30 s for a slot (503 LLM_BUSY).
LLM_MAX_CONCURRENCY=2
# Per-user /plans/parse requests per hour (429 RATE_LIMITED above it).
PARSE_RATE_LIMIT_PER_HOUR=60

# AI hypotheses about a finished run (contract docs/v3_interpretation.md), same claude CLI.
# v4 (docs/v4_guardrails.md): interpretations run on a persisted queue with their own workers
# (INTERPRET_CONCURRENCY), not on the planner's LLM_MAX_CONCURRENCY slots; at most
# INTERPRET_QUEUE_MAX requests wait (503 QUEUE_FULL above it). The hourly limits are separate
# counters from the planner's. Cached interpretations do not count.
CLAUDE_INTERPRET_MODEL=claude-opus-5-5
CLAUDE_INTERPRET_TIMEOUT_SECONDS=180
INTERPRET_RATE_LIMIT_PER_HOUR=20
INTERPRET_RATE_LIMIT_PER_IP_PER_HOUR=40
INTERPRET_GLOBAL_LIMIT_PER_HOUR=100
INTERPRET_CONCURRENCY=1
INTERPRET_QUEUE_MAX=20

# AI budget in USD over a rolling 24 h, from each claude -p call's total_cost_usd (planner and
# interpreter, success or failure). Over budget: 429 AI_BUDGET_EXHAUSTED. Must be > 0.
AI_DAILY_BUDGET_USD=20
AI_USER_DAILY_BUDGET_USD=3

# Accounts: when false, POST /api/v1/auth/register returns 403 and accounts are created with
# `bin/flylab user create --username U --password P`.
REGISTRATION_OPEN=true
# Optional invite-only registration: when set (and REGISTRATION_OPEN=true), register needs
# "invite_code" equal to this value (403 INVITE_REQUIRED / INVALID_INVITE otherwise).
# REGISTRATION_INVITE_CODE=

# Execution budget limits
MAX_WALL_SECONDS=3600
